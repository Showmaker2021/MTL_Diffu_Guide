-                'multiprocessing.semaphore_tracker' in cmd
-                for cmd in proc.cmdline()
-        ]):
-            alive.remove(proc)
-
-    for c in children:
-        c.close()
-    max_retries = 5
-    for _ in range(max_retries):
-        _, alive = psutil.wait_procs(alive, 1.0)
-        if not alive:
-            break
-    if alive:
-        error_msg = ''
