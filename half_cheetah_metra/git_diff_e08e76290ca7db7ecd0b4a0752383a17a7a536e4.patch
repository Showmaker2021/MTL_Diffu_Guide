-        """
-
-    # pylint: disable=no-self-use
-    def network_input_spec(self):
-        """Network input spec.
-
-        Return:
-            list[str]: List of key(str) for the network inputs.
-
-        """
-        return []
-
-    # pylint: disable=no-self-use
-    def network_output_spec(self):
-        """Network output spec.
-
-        Return:
-            list[str]: List of key(str) for the network outputs.
-
-        """
-        return []
-
-    @property
-    def parameters(self):
