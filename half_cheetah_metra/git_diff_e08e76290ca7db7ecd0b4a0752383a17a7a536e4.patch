-    """
-    main_file = getattr(main, '__file__', None)
-    if not main_file:
-        return None, {}
-    main_file_path = os.path.abspath(main_file)
-    try:
-        git_root_path = subprocess.check_output(
-            ('git', 'rev-parse', '--show-toplevel'),
-            cwd=os.path.dirname(main_file_path),
