-        task_z = self.z
-
-        # task, batch
-        t, b, _ = obs.size()
-        obs = obs.view(t * b, -1)
-        task_z = [z.repeat(b, 1) for z in task_z]
-        task_z = torch.cat(task_z, dim=0)
