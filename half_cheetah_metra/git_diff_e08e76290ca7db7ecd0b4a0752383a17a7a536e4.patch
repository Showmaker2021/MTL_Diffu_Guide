-                      'slow. Set archive_launch_repo=False in wrap_experiment '
-                      'to disable this behavior.')
-    archive_path = os.path.join(log_dir, 'launch_archive.tar.xz')
-    subprocess.run(('tar', '--null', '--files-from', '-', '--xz', '--create',
-                    '--file', archive_path),
