-
-            # Calculate vanilla loss
-            with tf.name_scope('vanilla_loss'):
-                ll = policy_dist.log_prob(i.action_var, name='log_likelihood')
-                vanilla = ll * adv
-
-            # Calculate surrogate loss
-            with tf.name_scope('surrogate_loss'):
