-                torch.distributions.Normal(m, torch.sqrt(s)) for m, s in zip(
-                    torch.unbind(self.z_means), torch.unbind(self.z_vars))
-            ]
-            z = [d.rsample() for d in posteriors]
-            self.z = torch.stack(z)
-        else:
-            self.z = self.z_means
-
-    def update_context(self, timestep):
