-
-        Returns:
-            float: The average return in last epoch cycle.
-
-        """
-        last_return = None
-        runner.enable_logging = False
-
-        for _ in runner.step_epochs():
-            for cycle in range(self._steps_per_epoch):
-                runner.step_path = runner.obtain_samples(runner.step_itr)
