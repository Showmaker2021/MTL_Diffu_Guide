-            n_test_tasks = test_task_sampler.n_tasks
-        self._n_test_tasks = n_test_tasks
-        self._n_test_rollouts = n_test_rollouts
-        self._n_exploration_traj = n_exploration_traj
-        self._max_path_length = max_path_length
-        self._eval_itr = 0
